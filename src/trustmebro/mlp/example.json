{
    "instance": "data/learning-balanced/instance-01",
    "output": "data/experiments/mlp-followup",
    "defaults": {
        "hidden": [
            256
        ],
        "batch_rows": 8192,
        "epochs": 50,
        "patience": 5,
        "lr": 0.001,
        "weight_decay": 0.0001,
        "dropout": 0.0,
        "class_weight": "none",
        "label_smoothing": 0.0,
        "scaling": "maxabs",
        "seed": 1
    },
    "runs": [
        {
            "name": "baseline"
        },
        {
            "name": "unweighted-dropout",
            "dropout": 0.3
        },
        {
            "name": "unweighted-smoothing",
            "label_smoothing": 0.05
        },
        {
            "name": "unweighted-dropout-smoothing",
            "dropout": 0.3,
            "label_smoothing": 0.05
        },
        {
            "name": "inverse-sqrt",
            "class_weight": "inverse_sqrt"
        },
        {
            "name": "inverse-sqrt-dropout",
            "class_weight": "inverse_sqrt",
            "dropout": 0.3
        },
        {
            "name": "inverse-sqrt-smoothing",
            "class_weight": "inverse_sqrt",
            "label_smoothing": 0.05
        },
        {
            "name": "deeper-unweighted",
            "hidden": [
                256,
                128
            ]
        },
        {
            "name": "log-standard",
            "scaling": "log_standard"
        },
        {
            "name": "log-balanced",
            "scaling": "log_standard",
            "class_weight": "balanced"
        },
        {
            "name": "log-inv-sqrt",
            "scaling": "log_standard",
            "class_weight": "inverse_sqrt"
        },
        {
            "name": "log-maxabs",
            "scaling": "log_maxabs"
        },
        {
            "name": "log-maxabs-balanced",
            "scaling": "log_maxabs",
            "class_weight": "balanced"
        },
        {
            "name": "log-maxabs-inv-sqrt",
            "scaling": "log_maxabs",
            "class_weight": "inverse_sqrt"
        }
    ]
}
